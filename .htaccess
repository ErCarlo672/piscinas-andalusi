# Para alojamientos Apache (Hostinger y similares). En Cloudflare Pages se usa _headers.
ErrorDocument 404 /404.html

<IfModule mod_expires.c>
  ExpiresActive On
  # HTML siempre fresco: así cada publicación se ve al momento
  ExpiresByType text/html "access plus 0 seconds"
  # CSS y JS llevan ?v= en el enlace, así que pueden guardarse un mes
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
